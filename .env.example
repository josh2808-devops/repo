# Copy to .env and edit values

# Authentication
ADMIN_USERNAME=admin
# Generate with scripts/generate_admin.py
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# App settings
APP_SECRET_KEY=change_this_to_a_random_32+_char_string
YOLO_MODEL_NAME=yolov8n.pt
DETECTION_CONFIDENCE=0.35
INCIDENT_ALERT_COOLDOWN_SECONDS=120
MAX_CONCURRENT_STREAMS=9

# Alerting (optional)
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=no-reply@example.com

# Contacts per incident type (SMS numbers or email addresses)
# Example: {"accident": ["+15551234567"], "fire": ["firedesk@example.com"], "flood": ["+15557654321", "ops@example.com"]}
ALERT_CONTACTS_JSON={}

# Optional location label included in alerts
SITE_LOCATION_LABEL=Intersection A - Central Ave & 5th St