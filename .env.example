# Copy to .env and fill in values
# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers, e.g., +15551234567,+15557654321
ALERT_NUMBERS_FIRE=
ALERT_NUMBERS_ACCIDENT=
ALERT_NUMBERS_FLOOD=

# SMTP email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAILS_FIRE=
ALERT_EMAILS_ACCIDENT=
ALERT_EMAILS_FLOOD=

# Map/Location (optional)
DEFAULT_LOCATION_TEXT=

# Security
# Set to 'true' to require TOTP 2FA after password login (if the user has a TOTP secret)
REQUIRE_2FA=true